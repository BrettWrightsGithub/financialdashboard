    {
      "parameters": {
        "jsCode": "// Your incoming items look like: { \"body.accounts\": { ... } }\nconst accounts = $input\n  .all()\n  .map(i => i.json[\"body.accounts\"])  // <-- THIS is the key fix\n  .filter(Boolean);\n\n// Optional: dedupe by provider_account_id so bulk upsert doesn't repeat rows\nconst seen = new Set();\n\nconst accountsToUpsert = accounts\n  .map(a => ({\n    provider: 'plaid',\n    provider_account_id: a.account_id,\n    name: a.name,\n    institution: $('Loop Over Items').first().json.institution_name, \n    account_type: a.subtype ?? a.type ?? null,\n    mask: a.mask ?? null,\n    balance_current: a.balances?.current ?? null,\n    balance_available: a.balances?.available ?? null,\n    include_in_cashflow: true,\n    is_active: true,\n    updated_at: new Date().toISOString(),\n  }))\n  .filter(r => {\n    // enforce required fields + dedupe\n    if (!r.provider_account_id || !r.name) return false;\n    const k = `${r.provider}:${r.provider_account_id}`;\n    if (seen.has(k)) return false;\n    seen.add(k);\n    return true;\n  });\n\nreturn [{ json: { accountsToUpsert } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        736,
        1536
      ],
      "id": "2ed330c2-7eea-46d0-9a22-d6fc418f302e",
      "name": "transformAccounts"
    },
    {
      "parameters": {
        "jsCode": "// transactionTransform (Run Once for All Items)\n// Current input: Supabase upsert response rows for accounts (each item has id + provider_account_id)\n// We also pull Plaid transactions from node: \"accounts-Transactions\"\n\nconst PLAID_NODE = 'accounts-Transactions';\n\n// 1) Build lookup: Plaid account_id -> Supabase accounts.id (uuid)\nconst accountRows = $input.all().map(i => i.json).filter(Boolean);\n\nconst accountLookup = new Map(\n  accountRows\n    .filter(r => r.provider_account_id && r.id)\n    .map(r => [r.provider_account_id, r.id])\n);\n\n// 2) Pull all Plaid transactions from accounts-Transactions\nconst plaidItems = $items(PLAID_NODE);\n\nconst added = plaidItems\n  .flatMap(i => i.json.body?.added ?? [])\n  .filter(Boolean);\n\nconst modified = plaidItems\n  .flatMap(i => i.json.body?.modified ?? [])\n  .filter(Boolean);\n\nconst removed = plaidItems\n  .flatMap(i => i.json.body?.removed ?? [])\n  .filter(Boolean);\n\n// 3) Helper function to transform a Plaid transaction to our schema\nconst transformTransaction = (t) => {\n  const provider = 'plaid';\n  const provider_account_id = t.account_id ?? null;\n  const account_id = provider_account_id ? accountLookup.get(provider_account_id) : null;\n  const provider_transaction_id = t.transaction_id ?? null;\n  const date = t.date ?? t.authorized_date ?? null;\n  \n  // Negate Plaid amount: Plaid positive = outflow, we want positive = inflow\n  const amount = (typeof t.amount === 'number') ? -t.amount : -Number(t.amount);\n\n  // Merchant / counterparty enrichment\n  // Prefer the merchant-type counterparty; fall back to first counterparty\n  const merchantCp = (t.counterparties ?? []).find(c => c.type === 'merchant') ?? t.counterparties?.[0] ?? {};\n\n  const counterparty_name =\n    t.merchant_name ??\n    merchantCp.name ??\n    null;\n\n  const description_raw =\n    t.original_description ??\n    t.name ??\n    counterparty_name ??\n    null;\n\n  const description_clean =\n    t.name ??\n    counterparty_name ??\n    null;\n\n  const status = (t.pending === true) ? 'pending' : 'posted';\n\n  // Plaid category enrichment\n  const category_ai = \n    t.personal_finance_category?.detailed ??\n    t.personal_finance_category?.primary ??\n    (Array.isArray(t.category) ? t.category.join(' > ') : null);\n\n  const confidenceMap = {\n    'VERY_HIGH': 95,\n    'HIGH': 85,\n    'MEDIUM': 70,\n    'LOW': 50\n  };\n  const category_ai_conf = \n    confidenceMap[t.personal_finance_category?.confidence_level] ?? \n    (Array.isArray(t.category) ? 60 : null);\n\n  // Merchant identity fields\n  const merchant_entity_id =\n    t.merchant_entity_id ??\n    merchantCp.merchant_entity_id ??\n    merchantCp.entity_id ??\n    null;\n  const merchant_logo_url = merchantCp.logo_url ?? null;\n  const merchant_website = merchantCp.website ?? null;\n\n  // Counterparty metadata\n  const counterparty_type = merchantCp.type ?? null;\n  const counterparty_entity_id = merchantCp.entity_id ?? null;\n  const counterparty_confidence = merchantCp.confidence_level ?? null;\n\n  // Location fields\n  const loc = t.location ?? {};\n  const merchant_location_city = loc.city ?? null;\n  const merchant_location_region = loc.region ?? null;\n  const merchant_location_postal_code = loc.postal_code ?? null;\n\n  // Validate required fields\n  if (!provider_transaction_id || !account_id || !date || Number.isNaN(amount)) return null;\n\n  return {\n    provider,\n    provider_transaction_id,\n    account_id,\n    provider_account_id,\n    date,\n    amount,\n    description_raw,\n    description_clean,\n    counterparty_name,\n    provider_type: t.payment_channel ?? null,\n    status,\n    processing_status: 'complete',\n    category_ai,\n    category_ai_conf,\n    merchant_entity_id,\n    merchant_logo_url,\n    merchant_website,\n    counterparty_type,\n    counterparty_entity_id,\n    counterparty_confidence,\n    merchant_location_city,\n    merchant_location_region,\n    merchant_location_postal_code,\n    updated_at: new Date().toISOString(),\n  };\n};\n\n// 4) Transform added + modified (both go through UPSERT)\nconst seen = new Set();\n\nconst transactionsToUpsert = [...added, ...modified]\n  .map(t => {\n    const transformed = transformTransaction(t);\n    if (!transformed) return null;\n    \n    // Dedupe\n    const k = `${transformed.provider}:${transformed.provider_transaction_id}`;\n    if (seen.has(k)) return null;\n    seen.add(k);\n    \n    return transformed;\n  })\n  .filter(Boolean);\n\n// 5) Extract removed transaction IDs for soft delete\nconst removedTransactionIds = removed\n  .map(r => r.transaction_id)\n  .filter(Boolean);\n\nreturn [{\n  json: {\n    transactionsToUpsert,\n    removedTransactionIds,\n    counts: {\n      added: added.length,\n      modified: modified.length,\n      removed: removedTransactionIds.length,\n      totalUpsert: transactionsToUpsert.length,\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1184,
