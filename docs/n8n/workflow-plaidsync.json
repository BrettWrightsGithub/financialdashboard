      "id": "4149f22f-189c-454d-af59-86705ee6c844",
      "name": "accounts-Transactions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        288,
        1536
      ],
      "alwaysOutputData": false
